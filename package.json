      "<rootDir>/src/__tests__/**/*.test.ts"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.17.0",
    "next": "16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
